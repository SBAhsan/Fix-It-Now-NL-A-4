model User {
    id                String             @id @default(uuid())
    name              String
    email             String             @unique
    password          String
    phone             String
    role              UserRole           @default(CUSTOMER)
    status            UserStatus         @default(ACTIVE)
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
    technicianProfile TechnicianProfile?
    bookings          Booking[]

    @@index([role])
    @@map("users")
}
